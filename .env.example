# LLM provider: vertex | gemini | mock
#   vertex = Gemini family via Vertex AI / Agent Platform (AI Builder Cup — jalur utama)
#   gemini = Gemini API (OpenAI-compatible endpoint, AI Studio key)
#   mock   = demo tanpa API key
LLM_PROVIDER=vertex

# ── Vertex AI (express mode, API key — project GCP) ──────────────────────
# Key dari Google Cloud console (APIs & Services → Credentials), bound ke service account.
VERTEX_API_KEY=
VERTEX_MODEL=gemini-3.5-flash-lite
VERTEX_TIMEOUT=300

# ── Google Gemini API (keluarga Gemini — compliance AI Builder Cup; doc 21) ──
# Key dari AI Studio (format baru diawali "AQ."). Default model: gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=300

# Override model sekali-jalan dari shell (jangan didefinisikan di file ini):
#   LLM_MODEL=gemini-3.5-flash uvicorn app.main:app --reload

# Temperature rendah = reproducibility (mitigasi non-determinism, docs/05 §7)
LLM_TEMPERATURE=0.2

# Dev-only: izinkan POST /admin/model (tukar provider/model tanpa restart). 0 = mati.
ENABLE_ADMIN_SWITCH=1
